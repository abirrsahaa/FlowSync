# Copy to .env and fill in. Never commit the real .env.
# With no key set, the service runs against the deterministic StubLLM — everything
# (streaming, validation, evals, tests) works offline.

# Get a key from the Anthropic Console. Check the docs for the current model ID.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5

# Set to true to force stub mode even when a key is present.
LLM_STUB=false
